{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/sriram/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "akka@ai-marketplace": true,
    "akka-ext@akka-ext": true
  },
  "extraKnownMarketplaces": {
    "ai-marketplace": {
      "source": {
        "source": "github",
        "repo": "akka/ai-marketplace"
      }
    },
    "akka-ext": {
      "source": {
        "source": "directory",
        "path": "/Users/sriram/code/akka-ext-plugin"
      }
    }
  },
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  }
}
