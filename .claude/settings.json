{
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/sriram/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ai-marketplace": {
      "source": {
        "source": "github",
        "repo": "akka/ai-marketplace"
      }
    }
  },
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    }
  },
  "enabledPlugins": {
    "akka@ai-marketplace": true
  }
}
